{
  "name": "laser-ready",
  "private": true,
  "version": "0.0.0",
  "description": "A simple laser cutting software",
  "author": {
    "name": "Enric Balletbo i Serra",
    "email": "eballetbo@gmail.com"
  },
  "license": "GPL-3.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "VITE_ELECTRON=true vite",
    "build": "vite build",
    "build:linux": "npm run build && electron-builder --linux flatpak",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "npx playwright test --reporter=line"
  },
  "build": {
    "appId": "com.laserready.app",
    "productName": "LaserReady",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*"
    ],
    "linux": {
      "target": "flatpak",
      "category": "Graphics",
      "icon": "resources/icon.png"
    },
    "flatpak": {
      "runtimeVersion": "23.08",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "23.08"
    }
  },
  "dependencies": {
    "dompurify": "^3.4.8",
    "lucide-react": "^0.555.0",
    "opentype.js": "^1.3.4",
    "paper": "^0.12.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/dompurify": "^3.0.5",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "canvas": "^3.2.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.16"
  }
}
